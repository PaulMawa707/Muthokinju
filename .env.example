# Muthokinju only — this deployment serves Muthokinju alone
# (Wialon resources 19058437, 28938806 and 17382986, see src/lib/customer.ts).

# Required: secret used to encrypt the session cookie (min. 32 random characters)
SESSION_SECRET="replace-with-a-long-random-string"

# App login for Muthokinju (username / password on the login page).
# Muthokinju Wialon logins (...@muthokinju.co.ke) are also accepted;
# every other Wialon login is refused.
APP_LOGIN_USER="Muthokinju"
APP_LOGIN_PASSWORD="replace-me"

# Server Wialon read token, used behind the app login (its fleet is cut down
# to Muthokinju server-side — no other customer can be seen).
WIALON_API_KEY=""

# Optional overrides – Wialon connection
# WIALON_HOST="https://hst-api.wialon.com"
# WIALON_LOGIN_URL="https://hosting.wialon.com/login.html"
# WIALON_MAPS_URL="https://render-maps.wialon.com"   # used when Wialon does not name its own map renderer
# WIALON_OAUTH_CLIENT_ID="MuthokinjuHOS"              # app name shown on the Wialon sign-in page
# WIALON_OAUTH_ACCESS_TYPE="0x300"                    # 0x100 online tracking + 0x200 view data (read-only)
# WIALON_REPORT_SESSIONS="4"                          # parallel Wialon report sessions per user (reports, driver logs)
# BEHAVIOR_SESSIONS="16"                              # parallel Wialon sessions for behaviour and daily driving analysis

# Howen VSS (cameras, alarm clips) for the VSS tab. Read-only; everything is limited
# to the Muthokinju fleet server-side, even if the login can see other customers.
VSS_BASE_URL="https://vss.controltech-ea.com"
VSS_USERNAME=""
VSS_PASSWORD=""
# VSS_FLEET="MUTHOKINJU"           # VSS fleet name (fleets under it are included)
# VSS_TZ_OFFSET_HOURS="3"          # VSS reports times in platform time (EAT)
# VSS_HISTORY_ALARMS="3,123,115,116"  # alarm types also read from VSS alarm history (Camera Covered, Fatigue Driving, Phone Call)

# Depot / yard geofences ("Label=Wialon name|other name", comma-separated): vehicles in each now,
# vehicles not back by 17:00, and idling only counted outside them.
# DEPOT_GEOFENCES="Kyangombe Yard=KYANGOMBE YARD"
# IDLE_EXTREME_MIN="25"            # Idle extreme after this many minutes of idling outside the depots

# App database (Supabase, Muthokinju's own project): settings, FleetRun records and imports,
# Logistics routes, Needs attention items. Server-only, never NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Starting defaults for fleet rules; anything saved in Settings takes precedence
# SPEED_LIMIT_KMH="80"                    # overspeed alert threshold
# MOVING_SPEED_KMH="5"                    # at or above this speed a vehicle counts as moving
# OFFLINE_AFTER_HOURS="24"                # no data for this long = offline (Offline 6+ starts at 6 h, set in Settings)
# DAILY_DRIVE_LIMIT_HOURS="8"             # daily driving limit for vehicles without a driver key or tachograph
